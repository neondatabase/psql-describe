{
  "name": "psql-describe",
  "version": "0.2.1",
  "description": "psql's `\\d` (describe) family of commands ported to JavaScript.",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check:xslt": "tsc -p xslt",
    "translate": "xslt/build.sh",
    "build": "esbuild generated/describe.mjs --bundle --outfile=index.js --platform=neutral --target=es2020 --minify --line-limit=120",
    "test": "npm run test:api && npm run test:matrix",
    "test:api": "npm run build && node test/test-api.mjs",
    "test:matrix": "npm run build && node test/test-matrix.mjs",
    "bundleDemo": "esbuild demo-src/demo.js --bundle --outfile=demo/demo.js --platform=neutral --target=es2020",
    "end-to-end": "npm run check:xslt && npm run translate && npm run build && npm run test && npm run bundleDemo"
  },
  "type": "module",
  "author": "George MacKerron",
  "license": "postgresql",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "pg": "^8.23.0",
    "prettier": "^3.9.10",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-javascript": "^0.25.0",
    "typescript": "^7.0.2",
    "web-tree-sitter": "^0.27.1",
    "xslt3": "^2.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neondatabase/psql-describe"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "tree-sitter-c": false,
    "tree-sitter-javascript": false
  }
}
